---
import { CONTACT_HTML } from '../lib/ai/chatContext';
---

<div id="contact-component" class="hidden">
  <Fragment set:html={CONTACT_HTML} />

  <form
    data-contact-form
    class="border-terminal-dim mt-4 max-w-xl space-y-3 rounded border p-4"
    novalidate
  >
    <div class="text-terminal-bright">Envíame un mensaje</div>

    <label class="block">
      <span class="text-terminal-dim text-sm">Nombre</span>
      <input
        name="name"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        class="contact-input"
      />
    </label>

    <label class="block">
      <span class="text-terminal-dim text-sm">Email</span>
      <input
        name="email"
        type="email"
        required
        maxlength="200"
        autocomplete="email"
        class="contact-input"
      />
    </label>

    <label class="block">
      <span class="text-terminal-dim text-sm">Mensaje</span>
      <textarea name="message" required maxlength="2000" rows="4" class="contact-input"></textarea>
    </label>

    <!-- Honeypot anti-bots: invisible y fuera de tabulación para humanos -->
    <input
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
      class="contact-honeypot"
    />

    <div class="flex flex-wrap items-center gap-3">
      <button type="submit" class="menu-item contact-submit">▶ Enviar</button>
      <span data-contact-status class="text-sm" role="status" aria-live="polite"></span>
    </div>
  </form>
</div>

<script>
  import { getApiBase } from '../lib/api/client';

  document.addEventListener('loadView', (e: Event) => {
    const customEvent = e as CustomEvent;
    if (customEvent.detail.view !== 'contact') return;
    const terminal = window.terminal;
    const component = document.getElementById('contact-component');
    if (terminal && component) terminal.printOutput(component.innerHTML);
  });

  // Delegación: el formulario vive dentro del HTML inyectado del contacto.
  document.addEventListener('submit', async (e: Event) => {
    const form = (e.target as HTMLElement)?.closest(
      '[data-contact-form]'
    ) as HTMLFormElement | null;
    if (!form) return;
    e.preventDefault();

    const status = form.querySelector('[data-contact-status]') as HTMLElement | null;
    const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const setStatus = (text: string, cls: string): void => {
      if (status) {
        status.textContent = text;
        status.className = `text-sm ${cls}`;
      }
    };

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') || ''),
      email: String(data.get('email') || ''),
      message: String(data.get('message') || ''),
      website: String(data.get('website') || ''),
    };

    setStatus('Enviando…', 'text-terminal-dim');
    if (submit) submit.disabled = true;

    try {
      const apiBase = getApiBase();
      if (!apiBase) throw new Error('no-api');
      const res = await fetch(`${apiBase}/api/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
      if (res.ok && json.ok) {
        form.reset();
        setStatus('✓ Mensaje enviado. ¡Gracias!', 'success-text');
      } else {
        setStatus(json.error || 'No se pudo enviar el mensaje.', 'error-text');
        if (submit) submit.disabled = false;
      }
    } catch {
      setStatus('No hay conexión con el servidor de contacto.', 'error-text');
      if (submit) submit.disabled = false;
    }
  });
</script>
