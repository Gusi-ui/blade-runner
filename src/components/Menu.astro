---
// Componente de menú principal
---

<div id="menu-component" class="hidden">
  <div class="my-4 grid grid-cols-1 gap-4 md:grid-cols-2" role="menu" aria-label="Menú principal">
    <button type="button" class="menu-item" data-option="1" role="menuitem">
      <span class="text-terminal-bright">[1]</span> Noticias Tecnológicas
      <span class="text-terminal-dim ml-4 block text-xs">Cosmos e Inteligencia Artificial</span>
    </button>

    <button type="button" class="menu-item" data-option="2" role="menuitem">
      <span class="text-terminal-bright">[2]</span> Currículum de Gusi
      <span class="text-terminal-dim ml-4 block text-xs">Perfil profesional</span>
    </button>

    <button type="button" class="menu-item" data-option="3" role="menuitem">
      <span class="text-terminal-bright">[3]</span> Proyectos Debussy
      <span class="text-terminal-dim ml-4 block text-xs">Portfolio de desarrollo web</span>
    </button>

    <button type="button" class="menu-item" data-option="4" role="menuitem">
      <span class="text-terminal-bright">[4]</span> Juegos Retro
      <span class="text-terminal-dim ml-4 block text-xs">Snake, Tetris, Ahorcado, Tres en Raya</span
      >
    </button>

    <button type="button" class="menu-item" data-option="5" role="menuitem">
      <span class="text-terminal-bright">[5]</span> Calculadora Cósmica
      <span class="text-terminal-dim ml-4 block text-xs">Edad planetaria y datos NASA</span>
    </button>

    <button type="button" class="menu-item" data-option="6" role="menuitem">
      <span class="text-terminal-bright">[6]</span> Imagen Astronómica NASA
      <span class="text-terminal-dim ml-4 block text-xs"
        >APOD - Foto del día traducida al español</span
      >
    </button>

    <button type="button" class="menu-item" data-option="8" role="menuitem">
      <span class="text-terminal-bright">[8]</span> Asistente IA
      <span class="text-terminal-dim ml-4 block text-xs">Chat con Nexus-7</span>
    </button>

    <button type="button" class="menu-item" data-option="7" role="menuitem">
      <span class="text-terminal-bright">[7]</span> Salir
      <span class="text-terminal-dim ml-4 block text-xs">Cerrar sesión</span>
    </button>
  </div>

  <div class="text-terminal-dim mt-4 text-sm">
    Selecciona una opción escribiendo el número o el nombre del comando.
  </div>
</div>

<script>
  document.addEventListener('loadMenu', () => {
    // Cada invocación de `menu` imprime un contenedor nuevo: poblamos el ÚLTIMO
    // (usar un id fijo rellenaba el primero, ya fuera de vista → el menú "no aparecía").
    const containers = document.querySelectorAll('.menu-container');
    const menuContainer = containers[containers.length - 1] as HTMLElement | undefined;
    const menuComponent = document.getElementById('menu-component');

    if (menuContainer && menuComponent) {
      menuContainer.innerHTML = menuComponent.innerHTML;

      // Añadir event listeners a las opciones del menú
      const menuItems = menuContainer.querySelectorAll('.menu-item');
      menuItems.forEach(item => {
        item.addEventListener('click', () => {
          const option = item.getAttribute('data-option');
          const input = document.getElementById('terminal-input') as HTMLInputElement;
          if (input && option) {
            input.value = option;
            input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter' }));
          }
        });
      });
    }
  });
</script>

<style>
  /* Estilos adicionales para el menú si es necesario */
</style>
