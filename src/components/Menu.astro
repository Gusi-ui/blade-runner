---
// Componente de menú principal
---

<div id="menu-component" class="hidden">
  <div class="menu-list" role="menu" aria-label="Menú principal">
    <button type="button" class="menu-row" data-option="1" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        📰
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Noticias Tecnológicas</span>
        <span class="menu-row__desc">Cosmos e Inteligencia Artificial</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        1
      </span>
    </button>

    <button type="button" class="menu-row" data-option="2" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        📄
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Currículum de Gusi</span>
        <span class="menu-row__desc">Perfil profesional</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        2
      </span>
    </button>

    <button type="button" class="menu-row" data-option="3" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        🛰️
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Proyectos Debussy</span>
        <span class="menu-row__desc">Portfolio de desarrollo web</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        3
      </span>
    </button>

    <button type="button" class="menu-row" data-option="4" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        🎮
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Juegos Retro</span>
        <span class="menu-row__desc">Snake, Tetris, Ahorcado, Tres en Raya</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        4
      </span>
    </button>

    <button type="button" class="menu-row" data-option="5" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        🌌
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Calculadora Cósmica</span>
        <span class="menu-row__desc">Edad planetaria y datos NASA</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        5
      </span>
    </button>

    <button type="button" class="menu-row" data-option="6" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        🔭
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Imagen Astronómica NASA</span>
        <span class="menu-row__desc">APOD - Foto del día traducida al español</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        6
      </span>
    </button>

    <button type="button" class="menu-row" data-option="8" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        🤖
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Asistente IA</span>
        <span class="menu-row__desc">Chat con Nexus-7</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        8
      </span>
    </button>

    <button type="button" class="menu-row menu-row--exit" data-option="7" role="menuitem">
      <span class="menu-row__icon" aria-hidden="true">
        🚪
      </span>
      <span class="menu-row__body">
        <span class="menu-row__title">Salir</span>
        <span class="menu-row__desc">Cerrar sesión</span>
      </span>
      <span class="menu-row__key" aria-hidden="true">
        7
      </span>
    </button>
  </div>

  <div class="text-terminal-dim mt-4 text-sm">
    Toca una opción o escribe el número / nombre del comando.
  </div>
</div>

<script>
  document.addEventListener('loadMenu', () => {
    // Cada invocación de `menu` imprime un contenedor nuevo: poblamos el ÚLTIMO
    // (usar un id fijo rellenaba el primero, ya fuera de vista → el menú "no aparecía").
    const containers = document.querySelectorAll('.menu-container');
    const menuContainer = containers[containers.length - 1] as HTMLElement | undefined;
    const menuComponent = document.getElementById('menu-component');

    if (menuContainer && menuComponent) {
      menuContainer.innerHTML = menuComponent.innerHTML;

      // Añadir event listeners a las opciones del menú
      const menuItems = menuContainer.querySelectorAll('.menu-item');
      menuItems.forEach(item => {
        item.addEventListener('click', () => {
          const option = item.getAttribute('data-option');
          const input = document.getElementById('terminal-input') as HTMLInputElement;
          if (input && option) {
            input.value = option;
            input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter' }));
          }
        });
      });
    }
  });
</script>

<style>
  /* Estilos adicionales para el menú si es necesario */
</style>
