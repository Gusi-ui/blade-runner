---
// Componente APOD - Astronomy Picture of the Day de NASA
---

<div id="apod-component" class="hidden">
  <div class="section-title glitch" data-text="Imagen Astronómica del Día - NASA">
    Imagen Astronómica del Día - NASA
  </div>

  <div class="mb-4">
    <div id="apod-content" class="mb-4">
      <div class="loading-dots">Cargando imagen astronómica del día</div>
    </div>

    <div class="mb-4 flex gap-2">
      <button id="apod-refresh" class="menu-item px-3 py-1 text-xs">
        Actualizar
      </button>
      <button id="apod-random" class="menu-item px-3 py-1 text-xs">
        Imagen Aleatoria
      </button>
    </div>

    <div class="text-terminal-dim text-xs">
      <span id="apod-last-update">Última actualización: Nunca</span>
    </div>
  </div>

  <div class="text-terminal-dim mt-4 text-sm">Escribe 'help' para ver los comandos.</div>
</div>

<div
  id="apod-fullscreen-overlay"
  class="apod-fullscreen-overlay fixed inset-0 z-[200] hidden items-center justify-center bg-black/95 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Imagen astronómica a pantalla completa"
  tabindex="-1"
>
  <button
    type="button"
    id="apod-fullscreen-close"
    class="menu-item absolute top-4 right-4 z-10 px-3 py-1 text-xs"
    aria-label="Cerrar pantalla completa"
  >
    ✕ Cerrar (ESC)
  </button>
  <img
    id="apod-fullscreen-img"
    class="border-terminal-bright max-h-[calc(100vh-2rem)] max-w-[calc(100vw-2rem)] border-2 object-contain"
    alt=""
  />
</div>
