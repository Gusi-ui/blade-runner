---
// Asistente IA integrado en la terminal (vista de conversación).
// El contenido vive en un <template> y se clona en cada apertura, con
// listeners ligados a la instancia clonada (sin IDs duplicados).
---

<template id="chat-template">
  <div class="chat-instance">
    <div class="section-title glitch" data-text="Asistente Nexus-7">
      Asistente Nexus-7
    </div>

    <div class="text-terminal-dim mb-4 text-sm">
      Pregunta sobre proyectos, CV, comandos o tecnología. También puedes usar 'ask
      &lt;pregunta&gt;' directamente desde la terminal.
    </div>

    <div
      class="chat-messages border-terminal-dim mb-4 max-h-64 space-y-3 overflow-y-auto rounded border p-3"
      role="log"
      aria-live="polite"
    ></div>

    <div class="flex flex-col gap-2 sm:flex-row">
      <input
        type="text"
        class="chat-input border-terminal-dim text-terminal-text focus:border-terminal-bright min-w-0 flex-1 rounded border bg-black px-3 py-2 font-mono caret-current outline-none"
        placeholder="Escribe tu pregunta..."
        aria-label="Mensaje para el asistente"
      />
      <button class="chat-send menu-item shrink-0 px-4 py-2 sm:w-auto" type="button">
        Enviar
      </button>
    </div>

    <div class="chat-status text-terminal-dim mt-2 text-xs"></div>
    <div class="text-terminal-dim mt-4 text-sm">Escribe 'help' para ver los comandos.</div>
  </div>
</template>
