         </pre>
        </div>
      </div>

      <div class="text-terminal-dim flex flex-col items-start justify-between gap-2 text-xs sm:flex-row sm:items-center">
        <span>
          CONECTADO: <span id="terminal-datetime"></span>
        </span>
        <span>
          STATUS: <span class="text-green-400">ONLINE</span>
        </span>
      </div>
    </div>

    <div id="terminal-content" class="min-h-[calc(100vh-200px)]">
      <div
        id="boot-output"
        class="terminal-output"
        role="log"
        aria-live="polite"
        aria-label="Terminal output"
      >
        <p class="success-text mb-1">✓ Nexus-7 listo.</p>
        <p class="text-terminal-dim mb-4">Toca un atajo o escribe 'help' para ver los comandos.</p>
      </div>

      <div
        id="output-container"
        role="log"
        aria-live="polite"
        aria-label="Contenido dinámico de la terminal"
      ></div>

      <!-- Pie fijo: atajos (según la vista, ver chips.ts) + campo de entrada -->
      <div class="terminal-footer">
        <div id="quick-actions" class="quick-actions" role="toolbar" aria-label="Atajos"></div>
        <div class="terminal-input-line">
          <span class="terminal-prompt" aria-label="Prompt del sistema">
            <span class="hidden sm:inline">gusi@nexus:~</span>$
          </span>
          <div class="terminal-input-wrap">
            <input
              type="text"
              id="terminal-input"
              class="terminal-input"
              autocomplete="off"
              spellcheck="false"
              aria-label="Entrada de comandos de terminal"
              aria-describedby="terminal-help"
            />
            <span class="input-mirror" aria-hidden="true">
              <span id="mirror-text"></span>
              <span class="terminal-cursor"></span>
            </span>
          </div>
          <button
            type="button"
            id="terminal-send"
            class="terminal-send"
            aria-label="Ejecutar comando"
          >
            ▶
          </button>
        </div>
        <div
          id="completion-hint"
          class="text-terminal-dim mt-1 hidden text-xs"
          aria-hidden="true"
        ></div>
      </div>
    </div>
  </div>

  <!-- Scanline effect -->
  <div class="scanline"></div>
</div>

<script>
  import { renderBootInstant } from '../lib/terminal/boot';
  import { TerminalController, startHeaderClock } from '../lib/terminal/controller';
  import { chipsFor } from '../lib/terminal/chips';
  import { createTerminalSheet } from '../lib/terminal/sheet';

  window.terminal = new TerminalController();
  startHeaderClock();

  // La terminal vive en una capa a pantalla completa (TerminalSheet). Se crea en
  // el mismo tick que el controlador: su navegación inicial por hash la usa.
  const dialog = document.getElementById('terminal-sheet') as HTMLDialogElement;
  const input = document.getElementById('terminal-input') as HTMLInputElement;
  window.terminalSheet = createTerminalSheet(
    dialog,
    cmd => window.terminal?.run?.(cmd),
    () => input.focus()
  );
  document
    .querySelector('[data-close-terminal]')
    ?.addEventListener('click', () => window.terminalSheet?.close());

  // Atajos según la vista activa (evento 'viewchange' del controlador).
  const quickActions = document.getElementById('quick-actions');
  const renderChips = (view: string): void => {
    if (!quickActions) return;
    quickActions.replaceChildren(
      ...chipsFor(view).map(cmd => {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'quick-chip';
        chip.dataset.cmd = cmd;
        chip.textContent = cmd;
        return chip;
      })
    );
  };
  renderChips('');
  document.addEventListener('viewchange', e => renderChips((e as CustomEvent).detail.view));

  // El arranque animado no aporta en una capa que se abre bajo demanda.
  const bootOutput = document.getElementById('boot-output');
  if (bootOutput) renderBootInstant(bootOutput);
</script>

<!-- Área de ayuda accesible -->
<div id="terminal-help" class="sr-only">
  Terminal interactiva estilo Blade Runner. Usa comandos como ayuda, proyectos, noticias, juegos,
  etc. Navegación: flechas arriba/abajo para historial, Tab para autocompletar, Enter para ejecutar,
  Ctrl+L para limpiar.
</div>
