---
interface Props {
  title?: string;
}

// const { title = "BLADE RUNNER TERMINAL v1.0" } = Astro.props;
---

<div class="terminal-container">
  <div class="terminal-screen crt-flicker">
    <div class="terminal-header">
      <!-- Logo compacto solo en móvil: el ASCII completo desbordaba y provocaba
           scroll horizontal, así que se reserva para sm+ (abajo). -->
      <div class="mobile-logo sm:hidden" aria-label="GUSI.DEV — Sistema Nexus-7">
        <span class="mobile-logo__title">GUSI.DEV</span>
        <span class="mobile-logo__sub">SISTEMA NEXUS-7</span>
      </div>
      <!-- ASCII Art Header -->
      <div
        id="ascii-header-panel"
        class="ascii-header text-terminal-bright mb-4 hidden text-center sm:block"
      >
        <div class="ascii-title">
          <pre
            class="ascii-art glitch font-mono"
            data-text="╠═════════════════════════════════════════════════════════╣
