---
// Contenido de la terminal (salida, atajos y entrada). Vive dentro de TerminalSheet.
---

<div class="terminal-container">
  <div class="terminal-screen">
    <div id="terminal-content" class="pt-3">
      <div
        id="boot-output"
        class="terminal-output"
        role="log"
        aria-live="polite"
        aria-label="Terminal output"
      >
        <p class="success-text mb-1">✓ Nexus-7 listo.</p>
        <p class="text-terminal-dim mb-4">Toca un atajo o escribe 'help' para ver los comandos.</p>
      </div>

      <div
        id="output-container"
        role="log"
        aria-live="polite"
        aria-label="Contenido dinámico de la terminal"
      ></div>

      <!-- Pie fijo: atajos (según la vista, ver chips.ts) + campo de entrada -->
      <div class="terminal-footer">
        <div id="quick-actions" class="quick-actions" role="toolbar" aria-label="Atajos"></div>
        <div class="terminal-input-line">
          <span class="terminal-prompt" aria-label="Prompt del sistema">
            <span class="hidden sm:inline">gusi@nexus:~</span>$
          </span>
          <div class="terminal-input-wrap">
            <input
              type="text"
              id="terminal-input"
              class="terminal-input"
              autocomplete="off"
              spellcheck="false"
              aria-label="Entrada de comandos de terminal"
              aria-describedby="terminal-help"
            />
            <span class="input-mirror" aria-hidden="true">
              <span id="mirror-text"></span>
              <span class="terminal-cursor"></span>
            </span>
          </div>
          <button
            type="button"
            id="terminal-send"
            class="terminal-send"
            aria-label="Ejecutar comando"
          >
            ▶
          </button>
        </div>
        <div
          id="completion-hint"
          class="text-terminal-dim mt-1 hidden text-xs"
          aria-hidden="true"
        ></div>
      </div>
    </div>
  </div>
</div>

<!-- Área de ayuda accesible -->
<div id="terminal-help" class="sr-only">
  Terminal interactiva estilo Blade Runner. Usa comandos como ayuda, proyectos, noticias, juegos,
  etc. Navegación: flechas arriba/abajo para historial, Tab para autocompletar, Enter para ejecutar,
  Ctrl+L para limpiar.
</div>
