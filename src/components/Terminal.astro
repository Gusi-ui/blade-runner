         </pre>
        </div>
      </div>

      <div
        class="text-terminal-dim flex flex-col items-start justify-between gap-2 text-xs sm:flex-row sm:items-center"
      >
        <span>CONECTADO: <span id="terminal-datetime"></span></span>
        <span>STATUS: <span class="text-green-400">ONLINE</span></span>
      </div>
    </div>

    <div id="terminal-content" class="min-h-[calc(100vh-200px)]">
      <div class="terminal-output" role="log" aria-live="polite" aria-label="Terminal output">
        <p class="text-terminal-bright mb-2">Inicializando sistema...</p>
        <p class="mb-2">Cargando módulos del kernel...</p>
        <p class="mb-2">Estableciendo conexión con MAINFRAME...</p>
        <p class="success-text mb-4">✓ Sistema listo</p>
        <p class="mb-2">Escribe 'help' para ver los comandos disponibles.</p>
        <p class="mb-4">Escribe 'menu' para acceder al menú principal.</p>
      </div>

      <div
        id="output-container"
        role="log"
        aria-live="polite"
        aria-label="Contenido dinámico de la terminal"
      >
      </div>

      <div id="quick-actions" class="quick-actions" role="toolbar" aria-label="Acciones rápidas">
        <button type="button" class="quick-chip" data-cmd="menu">Menú</button>
        <button type="button" class="quick-chip" data-cmd="noticias">Noticias</button>
        <button type="button" class="quick-chip" data-cmd="apod">APOD</button>
        <button type="button" class="quick-chip" data-cmd="chat">Chat</button>
        <button type="button" class="quick-chip" data-cmd="juegos">Juegos</button>
      </div>

      <div class="terminal-input-line mt-2">
        <span class="terminal-prompt" aria-label="Prompt del sistema">gusi@nexus:~$</span>
        <input
          type="text"
          id="terminal-input"
          class="terminal-input"
          autocomplete="off"
          spellcheck="false"
          aria-label="Entrada de comandos de terminal"
          aria-describedby="terminal-help"
        />
        <button
          type="button"
          id="terminal-send"
          class="terminal-send menu-item"
          aria-label="Ejecutar comando"
        >
          ▶
        </button>
        <span class="terminal-cursor" aria-hidden="true"></span>
      </div>
      <div id="completion-hint" class="text-terminal-dim mt-1 hidden text-xs" aria-hidden="true">
      </div>
    </div>
  </div>

  <!-- Scanline effect -->
  <div class="scanline"></div>
</div>

<script>
  import { TerminalController, startHeaderClock } from '../lib/terminal/controller';

  window.terminal = new TerminalController();
  startHeaderClock();
</script>

<!-- Área de ayuda accesible -->
<div id="terminal-help" class="sr-only">
  Terminal interactiva estilo Blade Runner. Usa comandos como ayuda, menu, noticias, juegos, etc.
  Navegación: flechas arriba/abajo para historial, Tab para autocompletar, Enter para ejecutar,
  Ctrl+L para limpiar.
</div>
