---
// Componente de noticias tecnológicas
---

<div id="news-component" class="hidden">
  <div class="section-title glitch" data-text="Noticias Tecnológicas - IA y Cosmos">
    Noticias Tecnológicas - IA y Cosmos
  </div>

  <div class="mb-4">
    <div class="mb-4 flex gap-2">
      <button id="filter-ai" class="menu-item px-3 py-1 text-xs">
        IA
      </button>
      <button id="filter-cosmos" class="menu-item px-3 py-1 text-xs">
        Cosmos
      </button>
      <button id="filter-all" class="menu-item px-3 py-1 text-xs">
        Todas
      </button>
      <button id="refresh-news" class="menu-item px-3 py-1 text-xs">
        Actualizar
      </button>
    </div>

    <div id="news-content" class="mb-4">
      <div class="loading-dots">Cargando noticias</div>
    </div>

    <div class="text-terminal-dim text-xs">
      <span id="last-update">Última actualización: Nunca</span> |
      <span id="news-count">0 noticias cargadas</span>
    </div>
  </div>

  <div class="text-terminal-dim mt-4 text-sm">Escribe 'menu' para volver al menú principal.</div>
</div>

<script>
  import { fetchNews as fetchNewsApi, type NewsArticle } from '../lib/api/client';
  import { translateBatch } from '../lib/api/translate';
  import { escapeHtml, safeUrl } from '../lib/terminal/sanitize';
  import { formatRelativeTime } from '../lib/utils/relativeTime';

  // Cuántas noticias se muestran/traducen. Menos = carga mucho más rápida.
  const NEWS_LIMIT = 6;

  type NewsFilter = 'all' | 'ai' | 'cosmos';
  const FILTER_LABELS: Record<NewsFilter, string> = {
    all: 'Todas',
    ai: 'IA y Tecnología',
    cosmos: 'Espacio y Ciencia',
  };
  const isFilter = (value: string): value is NewsFilter => value in FILTER_LABELS;

  class NewsFeed {
    private updateInterval: number = 300000;
    private intervalId?: number;
    private currentFilter: NewsFilter = 'all';
    // Noticias ya traducidas por categoría: cambiar de filtro no repite peticiones.
    private cache = new Map<NewsFilter, { at: number; articles: NewsArticle[] }>();
    // Descarta respuestas de cargas anteriores (p. ej. cambiar de filtro a mitad).
    private loadId = 0;
    // Bloque de la terminal de ESTA instancia (ids repetidos al reimprimir →
    // getElementById global devolvía el bloque antiguo y "no aparecía").
    private root: HTMLElement | null = null;

    setRoot(el: HTMLElement | null): void {
      this.root = el;
    }

    private q<T extends Element>(selector: string): T | null {
      return (this.root ?? document).querySelector<T>(selector);
    }

    // La API ya filtra por categoría. Se pinta el original en cuanto llega y la
    // traducción después: antes todo esperaba a traducir (y podía tardar >20 s).
    async fetchNews(force = false): Promise<void> {
      const filter = this.currentFilter;
      const id = ++this.loadId;
      const cached = this.cache.get(filter);
      if (cached && !force && Date.now() - cached.at < this.updateInterval) {
        this.render(cached.articles);
        return;
      }

      const newsContent = this.q<HTMLElement>('#news-content');
      if (!newsContent) return;
      newsContent.innerHTML = '<div class="loading-dots">Cargando noticias</div>';

      try {
        const articles = (await fetchNewsApi(filter)).slice(0, NEWS_LIMIT);
        if (id !== this.loadId) return;
        if (articles.length === 0) {
          this.showEnhancedDemoNews();
          return;
        }
        this.render(articles, true);

        // Una sola petición para todos los títulos y descripciones.
        const results = await translateBatch(
          articles.flatMap(article => [article.title, article.description ?? ''])
        );
        const translated = articles.map((article, i) => ({
          ...article,
          title: results[2 * i].text,
          description: results[2 * i + 1].text,
        }));
        this.cache.set(filter, { at: Date.now(), articles: translated });
        if (id === this.loadId) this.render(translated);
      } catch (error) {
        console.error('Error al obtener noticias:', error);
        if (id === this.loadId) this.showEnhancedDemoNews();
      }
    }

    private render(articles: NewsArticle[], translating = false): void {
      const newsContent = this.q<HTMLElement>('#news-content');
      const newsCount = this.q<HTMLElement>('#news-count');
      if (!newsContent || !newsCount) return;

      const items = articles
        .map((article, index) => {
          const date =
            formatRelativeTime(article.publishedAt) ||
            new Date(article.publishedAt).toLocaleDateString('es-ES');
          return `
            <div class="news-item border-l-2 border-terminal-dim pl-4 py-2 hover:bg-terminal-dim/10 transition-colors">
              <div class="text-terminal-bright text-base font-semibold">${index + 1}. ${escapeHtml(article.title)}</div>
              <div class="text-base mt-1">${escapeHtml(article.description || 'Sin descripción')}</div>
              <div class="text-sm text-terminal-dim mt-2">
                <span>${escapeHtml(article.source.name)}</span> |
                <span>${date}</span> |
                <a href="${safeUrl(article.url)}" target="_blank" rel="noopener noreferrer"
                   class="text-terminal-text hover:text-terminal-bright underline">
                  Leer más →
                </a>
              </div>
            </div>`;
        })
        .join('');

      newsContent.innerHTML = `
        <div class="text-terminal-bright mb-3">📋 Categoría: <span class="news-category">${FILTER_LABELS[this.currentFilter]}</span></div>
        ${translating ? '<div class="news-translating loading-dots text-sm text-terminal-dim mb-3">Traduciendo al español</div>' : ''}
        <div class="space-y-4">${items}</div>`;
      newsCount.textContent = `${articles.length} noticias cargadas`;
      this.updateLastUpdateTime();
    }

    private updateLastUpdateTime(): void {
      const lastUpdate = this.q<HTMLElement>('#last-update');
      if (lastUpdate) {
        const now = new Date();
        lastUpdate.textContent = `Última actualización: ${now.toLocaleTimeString('es-ES')}`;
      }
    }

    private showEnhancedDemoNews(): void {
      const newsContent = this.q<HTMLElement>('#news-content');
      const newsCount = this.q<HTMLElement>('#news-count');

      if (!newsContent || !newsCount) return;

      const demoArticles = [
        {
          title: '🚀 NASA anuncia nuevo telescopio espacial James Webb',
          description:
            'El telescopio más avanzado de la humanidad revela imágenes inéditas del universo profundo, mostrando galaxias formadas poco después del Big Bang.',
          source: 'NASA News',
          publishedAt: new Date().toISOString(),
        },
        {
          title: '🤖 Inteligencia Artificial revoluciona la medicina',
          description:
            'Nuevos algoritmos de IA pueden diagnosticar enfermedades con mayor precisión que los médicos humanos, abriendo nuevas posibilidades en el tratamiento temprano.',
          source: 'Tech Today',
          publishedAt: new Date().toISOString(),
        },
        {
          title: '🌌 Descubren planeta similar a la Tierra en zona habitable',
          description:
            'Astrónomos encuentran un exoplaneta con condiciones similares a nuestro planeta, relanzando la búsqueda de vida extraterrestre.',
          source: 'Space Daily',
          publishedAt: new Date().toISOString(),
        },
        {
          title: '💡 Avances en energía nuclear para viajes espaciales',
          description:
            'Científicos desarrollan nuevos sistemas de propulsión que podrían llevar humanos a Marte en tiempo récord.',
          source: 'Science Magazine',
          publishedAt: new Date().toISOString(),
        },
        {
          title: '🧠 Neuralink comienza pruebas clínicas en humanos',
          description:
            'La interfaz cerebro-computadora de Elon Musk muestra resultados prometedores en pacientes con parálisis.',
          source: 'Future Tech',
          publishedAt: new Date().toISOString(),
        },
      ];

      let html = `
        <div class="border border-terminal-bright p-4 rounded mb-4">
          <div class="text-terminal-bright text-lg mb-2">📰 NOTICIAS DE DEMOSTRACIÓN</div>
          <div class="text-sm text-terminal-dim mb-4">
            Mientras se resuelve el problema con la API de noticias, aquí tienes algunas noticias de ejemplo sobre tecnología y espacio.
          </div>
        </div>
        <div class="space-y-4">
      `;

      demoArticles.forEach((article, index) => {
        const date = new Date(article.publishedAt).toLocaleDateString('es-ES');
        html += `
          <div class="border-l-2 border-terminal-dim pl-4 py-2 hover:bg-terminal-dim/10 transition-colors">
            <div class="text-terminal-bright">${index + 1}. ${escapeHtml(article.title)}</div>
            <div class="text-sm mt-1">${escapeHtml(article.description)}</div>
            <div class="text-xs text-terminal-dim mt-2">
              <span>${article.source}</span> |
              <span>${date}</span> |
              <span class="text-terminal-bright">[DEMO]</span>
            </div>
          </div>
        `;
      });

      html += '</div>';
      newsContent.innerHTML = html;
      newsCount.textContent = `${demoArticles.length} noticias de demostración`;

      this.updateLastUpdateTime();
    }

    // Solo programa el refresco cada 5 minutos; la carga inicial la hace setFilter.
    startAutoUpdate(): void {
      this.intervalId = window.setInterval(() => {
        void this.fetchNews(true);
      }, this.updateInterval);
    }

    stopAutoUpdate(): void {
      if (this.intervalId) {
        clearInterval(this.intervalId);
      }
    }

    setFilter(filter: string): void {
      this.currentFilter = isFilter(filter) ? filter : 'all';
      void this.fetchNews();
    }

    refreshNews(): void {
      this.cache.clear();
      void this.fetchNews(true);
    }
  }

  // Inicializar NewsFeed
  const newsFeed = new NewsFeed();

  // Exponer el newsFeed globalmente para debugging
  window.newsFeed = newsFeed;

  document.addEventListener('loadView', (e: Event) => {
    const customEvent = e as CustomEvent;
    if (customEvent.detail.view === 'news') {
      const terminal = window.terminal;
      const newsComponent = document.getElementById('news-component');

      if (terminal && newsComponent) {
        // Detener actualizaciones anteriores
        newsFeed.stopAutoUpdate();

        terminal.printOutput(newsComponent.innerHTML);

        // Acotar la instancia al bloque recién impreso (el último .terminal-output).
        const blocks = document.querySelectorAll('#output-container .terminal-output');
        const root = blocks[blocks.length - 1] as HTMLElement | undefined;
        newsFeed.setRoot(root ?? null);

        // Argumento del comando: 'news ai' | 'news cosmos' | 'news all'
        newsFeed.setFilter((customEvent.detail.args?.[0] as string | undefined) ?? 'all');
        newsFeed.startAutoUpdate();

        // Listeners de filtros y actualización, acotados a ESTE bloque
        if (root) {
          root
            .querySelector('#filter-ai')
            ?.addEventListener('click', () => newsFeed.setFilter('ai'));
          root
            .querySelector('#filter-cosmos')
            ?.addEventListener('click', () => newsFeed.setFilter('cosmos'));
          root
            .querySelector('#filter-all')
            ?.addEventListener('click', () => newsFeed.setFilter('all'));
          root
            .querySelector('#refresh-news')
            ?.addEventListener('click', () => newsFeed.refreshNews());
        }
      }
    } else {
      newsFeed.stopAutoUpdate();
    }
  });
</script>

<style>
  /* Estilos adicionales si es necesario */
</style>
