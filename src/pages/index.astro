---
import TerminalSheet from '../components/TerminalSheet.astro';
import Menu from '../components/Menu.astro';
import NewsFeed from '../components/NewsFeed.astro';
import CV from '../components/CV.astro';
import Projects from '../components/Projects.astro';
import Games from '../components/Games.astro';
import CosmicCalculator from '../components/CosmicCalculator.astro';
import APOD from '../components/APOD.astro';
import Chat from '../components/Chat.astro';
import Contact from '../components/Contact.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/site/AboutSection.astro';
import ContactSection from '../components/site/ContactSection.astro';
import Hero from '../components/site/Hero.astro';
import ProjectsSection from '../components/site/ProjectsSection.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import '../styles/global.css';

const title = 'Gusi · Desarrollador Full Stack — webs rápidas y a medida';
const description =
  'Webs rápidas y a medida para negocios y asociaciones: desarrollo con Astro y Cloudflare, migraciones desde WordPress y mantenimiento.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main>
    <Hero />
    <ProjectsSection />
    <AboutSection />
    <ContactSection />
  </main>
  <SiteFooter />

  <!-- Terminal en capa a pantalla completa -->
  <TerminalSheet />

  <!-- Componentes Ocultos (se cargan dinámicamente) -->
  <Menu />
  <NewsFeed />
  <CV />
  <Projects />
  <Games />
  <CosmicCalculator />
  <APOD />
  <Chat />
  <Contact />

  <script>
    // Preferencias guardadas de la terminal (tema y efectos).
    try {
      const savedTheme = localStorage.getItem('nexus-theme');
      if (savedTheme) document.body.classList.add(`theme-${savedTheme}`);
      if (localStorage.getItem('nexus-reduced-effects') === 'true') {
        document.body.classList.add('reduced-effects');
      }
    } catch {
      /* almacenamiento no disponible (modo privado): se usan los valores por defecto */
    }
  </script>
</BaseLayout>
