---
import TerminalSheet from '../components/TerminalSheet.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/site/AboutSection.astro';
import ContactSection from '../components/site/ContactSection.astro';
import Hero from '../components/site/Hero.astro';
import ProjectsSection from '../components/site/ProjectsSection.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import '../styles/global.css';

const title = 'Gusi · Desarrollador Full Stack — webs rápidas y a medida';
const description =
  'Webs rápidas y a medida para negocios y asociaciones: desarrollo con Astro y Cloudflare, migraciones desde WordPress y mantenimiento.';
---

<BaseLayout title={title} description={description}>
  <SiteHeader />
  <main>
    <Hero />
    <ProjectsSection />
    <AboutSection />
    <ContactSection />
  </main>
  <SiteFooter />

  <!-- Terminal en capa a pantalla completa -->
  <TerminalSheet />

  <script>
    // Arranque ligero de la terminal: su código y el de sus vistas se descargan
    // al abrirla por primera vez (lazy.ts). Aquí solo se decide cuándo.
    import { classifyHash } from '../lib/terminal/hashRoute';
    import { VIEW_TOKENS } from '../lib/terminal/viewTokens';

    const load = () => import('../lib/terminal/lazy').then(m => m.ensureTerminal());

    // Enlaces #terminal, #apod, #news…: cargar; el controlador abre la vista.
    const target = classifyHash(location.hash, token => VIEW_TOKENS.includes(token));
    if (target.kind === 'terminal' || target.kind === 'view') void load();
    // Enlaces antiguos (#cv, #projects…) → su sección nueva de la página.
    if (target.kind === 'section' && location.hash.slice(1) !== target.id) {
      history.replaceState(null, '', `#${target.id}`);
      document.getElementById(target.id)?.scrollIntoView();
    }

    // Primer toque en la terminal viva (luego lo gestiona la propia capa).
    document.addEventListener('click', e => {
      const trigger = (e.target as HTMLElement | null)?.closest<HTMLElement>(
        '[data-open-terminal]'
      );
      if (!trigger || window.terminalSheet) return;
      e.preventDefault();
      void load().then(sheet => sheet.open(trigger.dataset.command));
    });

    // Tema guardado de la terminal (solo cambia el acento dentro de la capa).
    try {
      const savedTheme = localStorage.getItem('nexus-theme');
      if (savedTheme && savedTheme !== 'classic') {
        document.documentElement.dataset.theme = savedTheme;
      }
      if (localStorage.getItem('nexus-reduced-effects') === 'true') {
        document.body.classList.add('reduced-effects');
      }
    } catch {
      /* almacenamiento no disponible (modo privado): se usan los valores por defecto */
    }
  </script>
</BaseLayout>
