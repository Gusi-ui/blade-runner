{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blade-runner-api",
  // Cuenta "Gusi" (jmartinezblanquez@gmail.com). Fijarla evita que wrangler use otra
  // sesión o una caché antigua. El Account ID no es secreto.
  "account_id": "1f7c0d40473dbca21d83ed0495b171db",
  "main": "src/index.ts",
  // Este Worker sirve la web (dist/ de Astro) y la API (/api/*). Recibe todas las
  // peticiones para poder redirigir www y fijar cabeceras de caché/seguridad.
  // Compilar la web (pnpm build en la raíz) antes de desplegar.
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  // Producción (rama main). El DNS de gusi.dev no cambia: estas rutas tienen
  // prioridad sobre cualquier origen. Sin estas rutas el dominio se queda sin web.
  "routes": [
    { "pattern": "gusi.dev/*", "zone_name": "gusi.dev" },
    { "pattern": "www.gusi.dev/*", "zone_name": "gusi.dev" },
  ],
  // El Worker solo se sirve en gusi.dev: nada de *.workers.dev ni URLs de
  // vista previa por versión (evita copias públicas de la web y de la API).
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "a3e792f86dac42f581760caab4581d90",
    },
  ],
  "ai": {
    "binding": "AI",
  },
  "send_email": [
    {
      "name": "EMAIL",
      // Plan gratuito: solo se puede enviar a direcciones de destino verificadas
      // (Email Routing). Se restringe a ese único destinatario y remitente.
      "destination_address": "gusideveloper@gmail.com",
      "allowed_sender_addresses": ["contacto@gusi.dev"],
    },
  ],
  // Rate limiting por IP (period solo admite 10 o 60 segundos).
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      // Holgado: la vista de noticias traduce ~40 textos a la vez (solo cuenta si no hay caché).
      "name": "TRANSLATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 2, "period": 60 },
    },
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://gusi.dev",
    "CONTACT_TO": "gusideveloper@gmail.com",
    "ENVIRONMENT": "production",
    // Dominios del frontend aceptados por Turnstile (nunca localhost en producción).
    // El secreto TURNSTILE_SECRET va como secret del Worker.
    "TURNSTILE_HOSTNAMES": "gusi.dev",
  },

  "env": {
    // Staging (rama develop) en https://dev.gusi.dev: mismo código y datos, para
    // probar antes de pasar a producción. Las bindings no se heredan: se repiten.
    // Secretos propios (opcionales): wrangler secret put NASA_API_KEY --env staging
    "staging": {
      "name": "blade-runner-staging",
      "routes": [{ "pattern": "dev.gusi.dev", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      // KV propio: si compartiera el de producción, staging podría dejarle datos
      // cacheados erróneos (pasó con las noticias sin claves de la API).
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "924b3cb56c6c44768c703e1325ae2df1",
        },
      ],
      "ai": {
        "binding": "AI",
      },
      "send_email": [
        {
          "name": "EMAIL",
          // Plan gratuito: solo se puede enviar a direcciones de destino verificadas
          // (Email Routing). Se restringe a ese único destinatario y remitente.
          "destination_address": "gusideveloper@gmail.com",
          "allowed_sender_addresses": ["contacto@gusi.dev"],
        },
      ],
      "ratelimits": [
        {
          "name": "CHAT_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "TRANSLATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "CONTACT_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 2, "period": 60 },
        },
      ],
      "vars": {
        "ALLOWED_ORIGIN": "https://dev.gusi.dev",
        "CONTACT_TO": "gusideveloper@gmail.com",
        "ENVIRONMENT": "staging",
        "TURNSTILE_HOSTNAMES": "dev.gusi.dev",
      },
    },
  },
}
