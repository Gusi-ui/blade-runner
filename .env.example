# URL del Cloudflare Worker (ej: https://blade-runner-api.tu-subdominio.workers.dev)
# Con el Worker configurado no hace falta ninguna clave en el cliente.
PUBLIC_API_BASE_URL=

# SOLO para desarrollo local sin Worker. ¡Atención! Toda variable PUBLIC_* se
# incrusta en el JavaScript público: nunca las definas en el build de producción.
# PUBLIC_NASA_API_KEY=DEMO_KEY
# PUBLIC_GUARDIAN_API_KEY=test
